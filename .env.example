# --- App ---
PORT=3000
CORS_ORIGIN=http://localhost:4200

# --- Kick (https://kick.com/settings/developer) ---
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Debe coincidir con el Redirect URI de tu app en Kick. Kick exige una URL pública
# (en desarrollo: Cloudflare Tunnel o ngrok apuntando al puerto de este backend).
KICK_REDIRECT_URI=https://TU-TUNEL.trycloudflare.com/kick/auth/callback
# El Webhook URL de la app en Kick debe ser: https://TU-TUNEL.trycloudflare.com/kick/webhook

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kick_chatbot?schema=public"

# --- TTS: Fish Audio ---
FISH_API_KEY=
# Modelo de Fish: s2.1-pro (por defecto), s1, s2-pro, drama-3...
FISH_MODEL=s2.1-pro

# --- Control de gasto del TTS (se cobra por carácter) ---
# "all" lee todo el chat; "command" solo mensajes que empiecen con TTS_COMMAND
TTS_READ_MODE=all
TTS_COMMAND=!tts
TTS_MAX_CHARS=100
TTS_USER_COOLDOWN_SECONDS=10
# Tope diario de caracteres sintetizados (50000 ≈ $0.75/día a $15 por millón)
TTS_DAILY_CHAR_CAP=50000
# Palabras prohibidas, separadas por coma
TTS_BLOCKED_WORDS=

# --- Spotify (https://developer.spotify.com/dashboard) ---
# Solo hace falta el Client ID (login con PKCE, sin secreto). El Redirect URI debe estar
# registrado igual en la app de Spotify: https://TU-DOMINIO/kick-tts/spotify/auth/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=
# Opcional: permiso extra de Kick para responder en el chat (ej. chat:write)
KICK_EXTRA_SCOPES=

# --- Panel de administración ---
# Contraseña del panel, secreto para firmar el JWT y token de los overlays de OBS (genera valores largos y aleatorios)
ADMIN_PASSWORD=
JWT_SECRET=
OVERLAY_TOKEN=
# URL pública del frontend (el login de Spotify redirige aquí al terminar)
FRONTEND_URL=
# Carpeta donde se guardan las imágenes y audios subidos para las alertas y comandos
ALERTS_DIR=
